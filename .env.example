# Copy this file to .env and fill it in. docker compose reads .env automatically,
# and .env is ignored by git so your token stays private.

# The admin password: turns on admin sign-in, uploads and WebDAV sync.
# Leave empty to keep uploads and WebDAV off. Generate one with:  openssl rand -hex 16
UPLOAD_TOKEN=

# Optional: TV, film and audiobooks. These can also be set on the admin page (Other media).
# A TMDB key (v3 key or v4 read token) adds genres and posters.
TMDB_API_KEY=
# Tautulli, for Plex watch history, e.g. http://tautulli:8181
TAUTULLI_URL=
TAUTULLI_API_KEY=
# Audiobookshelf, for audiobook listening, e.g. http://audiobookshelf:13378
AUDIOBOOKSHELF_URL=
AUDIOBOOKSHELF_TOKEN=

# Optional: anonymous usage analytics (which views are opened, which controls are used) in Mixpanel.
# Leave empty to keep it off. MIXPANEL_API_HOST=https://api-eu.mixpanel.com for EU data residency.
MIXPANEL_TOKEN=

# Optional: deploy on push (see "Deploy on push" in the README). IMAGE runs the image CI
# builds instead of building here; DEPLOY_SECRET is shared with the DEPLOY_SECRET Actions
# secret (openssl rand -hex 32); DEPLOY_DIR is this folder's absolute path on the server.
IMAGE=
DEPLOY_SECRET=
DEPLOY_DIR=
