<!--
  TRMNL private plugin markup (Full view) for the reading dashboard's /api/trmnl.
  Plugin settings: Strategy "Polling", Polling URL https://your-dashboard/api/trmnl,
  Polling headers  authorization=Bearer YOUR_DEVICE_TOKEN  (see the README).
  The simplest alternative: show the server's own picture with
    <img src="{{ image_url }}" style="width:100%;height:100%">
  Classes are TRMNL's design framework (https://usetrmnl.com/framework).
-->
<div class="view view--full">
  <div class="layout layout--row layout--top gap--large">
    {% if cover_url %}
      <img class="image image-dither" src="{{ cover_url }}" style="width:190px;height:285px;object-fit:cover;border:2px solid black">
    {% endif %}
    <div class="layout layout--col gap--medium" style="flex:1">
      {% if title %}
        <span class="title title--large clamp--2">{{ title }}</span>
        <span class="description">{{ author }}</span>
        {% if progress %}
          <div class="progress-bar">
            <div class="track"><div class="fill" style="width: {{ progress }}%"></div></div>
            <span class="value value--xsmall">{{ progress }}%</span>
          </div>
        {% endif %}
      {% elsif reading_shared %}
        <span class="title title--large">Nothing on the go</span>
      {% endif %}
      <div class="grid grid--cols-{{ stats.size }}">
        {% for s in stats %}
          <div class="item">
            <div class="meta"></div>
            <div class="content">
              <span class="value value--small">{{ s.value }}</span>
              <span class="label">{{ s.label }} · {{ s.sub }}</span>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
  {% if quote %}
    <div class="divider"></div>
    <div class="richtext">
      <p class="content content--small clamp--3">“{{ quote }}”</p>
      <p class="label label--small">— {{ quote_source }}</p>
    </div>
  {% endif %}
</div>
<div class="title_bar">
  <span class="title">Reading</span>
  <span class="instance">{{ today }}</span>
</div>
